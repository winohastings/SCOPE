+from __future__ import annotations
+
+import hashlib
+
+import numpy as np
+from PIL import Image
+
+CAMERAS = ("front", "left", "right", "rear")
+POLICY_MODES = ("original", "glance_only", "fixed_2", "random_2", "learned_2", "learned_adaptive")
+STOP = 16
+
+
+def prepare_scope_images(images):
+    raw = {}
+    for camera in CAMERAS:
+        image = Image.fromarray(np.asarray(images[camera], dtype=np.uint8)).convert("RGB")
+        if image.size != (512, 512):
+            raise ValueError(f"SCOPE requires raw 512x512 {camera}, got {image.size}")
+        raw[camera] = image.copy()
+    compatible = {camera: image.resize((256, 256), Image.Resampling.BICUBIC) for camera, image in raw.items()}
+    glance = {camera: image.resize((128, 128), Image.Resampling.BICUBIC) for camera, image in raw.items()}
+    candidates = []
+    for camera_id, camera in enumerate(CAMERAS):
+        for region in range(4):
+            left, top = (region % 2) * 256, (region // 2) * 256
+            roi = [left, top, left + 256, top + 256]
+            candidates.append({"candidate_id": len(candidates), "camera_id": camera_id,
+                               "camera_name": camera, "roi": roi, "image": raw[camera].crop(roi)})
+    return raw, compatible, glance, candidates
+
+
+def select_focus(mode, *, seed, episode_id, step, glance, candidates, selector=None):
+    if mode not in POLICY_MODES:
+        raise ValueError(f"Unknown policy_mode: {mode}")
+    if mode in ("original", "glance_only"):
+        return [], []
+    digest = hashlib.sha256(f"{seed}:{episode_id}:{step}".encode()).digest()
+    rng = np.random.default_rng(int.from_bytes(digest[:8], "little"))
+    selected, trace = [], []
+    for focus_index in range(2):
+        available = [index for index in range(16) if index not in selected]
+        if mode == "fixed_2":
+            action = (0, 3)[focus_index]
+        elif mode == "random_2":
+            action = int(rng.choice(available))
+        else:
+            if selector is None:
+                raise ValueError("learned modes require an explicit selector; no silent fixed/random fallback")
+            action = int(selector(glance=glance, selected=[candidates[index] for index in selected],
+                                  available=available, allow_stop=mode == "learned_adaptive",
+                                  focus_index=focus_index, rng=rng))
+        trace.append(action)
+        if action == STOP:
+            if mode != "learned_adaptive":
+                raise ValueError("STOP is only valid for learned_adaptive")
+            break
+        if action not in available:
+            raise ValueError(f"Invalid or repeated Focus action: {action}")
+        selected.append(action)
+    return [{**candidates[index], "focus_index": position} for position, index in enumerate(selected)], trace
