+from __future__ import annotations
+
+import gzip
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+from benchmark.vlnce.inputs import _open_json_or_json_gz, _split_paths
+
+
+class R2RSplitPathTests(unittest.TestCase):
+    def test_empty_standard_directory_does_not_hide_local_annotations(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            standard = root / "datasets" / "R2R_VLNCE_v1-3_preprocessed" / "val_unseen"
+            standard.mkdir(parents=True)
+            local = root / "R2R-CE" / "R2R_VLNCE_v1-3_preprocessed" / "val_unseen"
+            local.mkdir(parents=True)
+            annotation = local / "val_unseen.json.gz"
+            with gzip.open(annotation, "wt", encoding="utf-8") as stream:
+                json.dump({"episodes": []}, stream)
+            selected = _split_paths(root, task_name="r2r", split="val_unseen", roles=())
+            self.assertEqual(selected, [annotation])
+            from benchmark.common.simulators.habitat.vlnce031_datasets import _split_file_path
+
+            self.assertEqual(
+                Path(_split_file_path(root, task_name="r2r", split="val_unseen", suffix="")),
+                annotation,
+            )
+
+    def test_input_layouts(self):
+        for layout in ("datasets", "R2RCE", "R2R-CE"):
+            for extension in (".json.gz", ".json"):
+                with self.subTest(layout=layout, extension=extension), tempfile.TemporaryDirectory() as temporary:
+                    root = Path(temporary)
+                    directory = root / layout / "R2R_VLNCE_v1-3_preprocessed" / "val_unseen"
+                    directory.mkdir(parents=True)
+                    annotation = directory / f"val_unseen{extension}"
+                    opener = gzip.open if extension.endswith(".gz") else open
+                    with opener(annotation, "wt", encoding="utf-8") as stream:
+                        json.dump({"episodes": []}, stream)
+                    selected = _split_paths(root, task_name="r2r", split="val_unseen", roles=())
+                    with _open_json_or_json_gz(selected[0]) as stream:
+                        self.assertEqual(json.load(stream), {"episodes": []})
+
+    def test_habitat_annotation_and_ground_truth_layouts(self):
+        from benchmark.common.simulators.habitat.vlnce031_datasets import _split_file_path
+
+        for layout in ("datasets", "R2RCE", "R2R-CE"):
+            for suffix in ("", "_gt"):
+                for extension in (".json.gz", ".json"):
+                    with self.subTest(layout=layout, suffix=suffix, extension=extension):
+                        with tempfile.TemporaryDirectory() as temporary:
+                            root = Path(temporary)
+                            directory = root / layout / "R2R_VLNCE_v1-3_preprocessed" / "val_unseen"
+                            directory.mkdir(parents=True)
+                            annotation = directory / f"val_unseen{suffix}{extension}"
+                            opener = gzip.open if extension.endswith(".gz") else open
+                            with opener(annotation, "wt", encoding="utf-8") as stream:
+                                json.dump({}, stream)
+                            selected = _split_file_path(root, task_name="r2r", split="val_unseen", suffix=suffix)
+                            with gzip.open(selected, "rt", encoding="utf-8") as stream:
+                                self.assertEqual(json.load(stream), {})
+
+
+if __name__ == "__main__":
+    unittest.main()
