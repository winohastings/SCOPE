diff --git a/deployment/model_server/legacy_rxr_server.py b/deployment/model_server/legacy_rxr_server.py
new file mode 100644
--- /dev/null
+++ b/deployment/model_server/legacy_rxr_server.py
@@ -0,0 +1,270 @@
+"""Serve the released navvla_qwen35_cpm RXR checkpoint with the current RPC protocol."""
+from __future__ import annotations
+
+import argparse
+import asyncio
+import json
+import sys
+from pathlib import Path
+from types import MethodType
+
+import numpy as np
+
+
+class LegacyRXRPolicy:
+    def __init__(
+        self,
+        checkpoint: str,
+        legacy_root: str,
+        qwen_root: str,
+        device: str = "cuda",
+        action_uncertainty: bool = False,
+        uncertainty_log: str | None = None,
+        uncertainty_mode: str = "hutchinson",
+        hutchinson_samples: int = 4,
+    ):
+        import importlib
+        import os
+
+        legacy_root = str(Path(legacy_root).resolve())
+        for module_name in tuple(sys.modules):
+            if module_name in {"starVLA", "NavVLAeval", "deployment"} or module_name.startswith(("starVLA.", "NavVLAeval.", "deployment.")):
+                del sys.modules[module_name]
+        sys.path = [legacy_root] + [item for item in sys.path if Path(item or os.getcwd()).resolve() != Path(__file__).resolve().parents[2]]
+        importlib.invalidate_caches()
+        import torch
+        from starVLA.model.framework.base_framework import baseframework
+        from NavVLAeval.common.data.runtime_dataset import OnlineNavVLARuntimeDatasetAdapter
+        from NavVLAeval.common.types import EpisodeHistory
+
+        self.torch = torch
+        self.EpisodeHistory = EpisodeHistory
+        self.adapter = OnlineNavVLARuntimeDatasetAdapter(
+            required_cameras=("front", "left", "right", "rear"),
+            action_horizon=8,
+            history_selection="bats",
+            history_update_mode="action_observations",
+            dataset_name="rxr",
+            bats_seed=42,
+            bats_epsilon=0.1,
+            bats_k=4.0,
+            use_dynamic_bats_k=True,
+            bats_sampling_mode="priority_capped",
+            bats_token_budget=1024,
+            budget_num_cameras=4,
+            current_visual_tokens=64,
+            history_visual_tokens=4,
+            tvi_tokens=1,
+            include_state=False,
+            eval_image_fps=1.0,
+        )
+        overrides = {
+            "framework": {
+                "name": "navvla_qwen35_cpm",
+                "qwenvl": {
+                    "base_vlm": str(Path(qwen_root).resolve()),
+                    "attn_implementation": "sdpa",
+                },
+                "navvla": {
+                    "use_platform_text": True,
+                    "tvi_mode": "time_yaw",
+                    "history_visual_tokens": 4,
+                    "long_memory_source_visual_tokens": 4,
+                    "long_memory_visual_tokens": 0,
+                    "current_visual_tokens": 64,
+                    "visual_token_profile": "qwen3_5_4b_postmerge_pool4_256_mmap",
+                    "visual_cache_stage": "vit_postmerge_pool4",
+                    "visual_cache_input_resize": [256, 256],
+                    "visual_cache_encoder_ckpt": str(Path(qwen_root).resolve()),
+                },
+                "action_model": {
+                    "action_dim": 4,
+                    "action_horizon": 8,
+                    "max_seq_len": 2048,
+                    "diffusion_model_cfg": {"cross_attention_dim": 2560, "interleave_self_attention": True},
+                },
+            }
+        }
+        self.model = baseframework.from_pretrained(checkpoint, config_overrides=overrides)
+        self.model = self.model.to(device).eval()
+        self.action_stats_by_key = self.model.norm_stats
+        self.action_uncertainty = action_uncertainty
+        self.uncertainty_log = Path(uncertainty_log) if uncertainty_log else None
+        self.uncertainty_mode = uncertainty_mode
+        self.hutchinson_samples = int(hutchinson_samples)
+        if action_uncertainty:
+            import importlib.util
+
+            head_path = Path(__file__).resolve().parents[2] / "starVLA/model/modules/action_model/GR00T_ActionHeader.py"
+            spec = importlib.util.spec_from_file_location("_adaperc_uncertainty_action_head", head_path)
+            if spec is None or spec.loader is None:
+                raise ImportError(f"Cannot load uncertainty action head: {head_path}")
+            module = importlib.util.module_from_spec(spec)
+            spec.loader.exec_module(module)
+            head = self.model.action_model
+            for method_name in ("_predict_velocity", "_predict_action_impl", "predict_action"):
+                setattr(head, method_name, MethodType(getattr(module.FlowmatchingActionHead, method_name), head))
+
+    def new_session(self, *, episode_id, statistics_key, seed):
+        key = statistics_key or "vln_train_train"
+        if key not in self.action_stats_by_key:
+            raise KeyError(f"statistics key not found: {key}")
+        self.adapter.set_action_stats(self.action_stats_by_key[key]["action"])
+        session = {
+            "episode_id": str(episode_id),
+            "seed": int(seed),
+            "history": self.EpisodeHistory(),
+            "frame_index": 0,
+            "prediction_index": 0,
+            "key": key,
+        }
+        return session
+
+    @staticmethod
+    def _observation(frame, frame_index):
+        return {
+            "images": {key: np.asarray(value, dtype=np.uint8) for key, value in frame["images"].items()},
+            "image": np.asarray(frame["images"]["front"], dtype=np.uint8),
+            "pose": np.asarray(frame.get("body_pose", [0, 0, 0, 0]), dtype=np.float32),
+            "navvla_eval": {"frame_index": int(frame_index), "timestamp": float(frame.get("timestamp_s", frame_index))},
+        }
+
+    @staticmethod
+    def _append_history(history, observation, instruction):
+        history.observations.append(observation)
+        history.instructions.append(str(instruction))
+
+    def _seeded_prediction(self, sample, seed):
+        with self.torch.random.fork_rng(devices=[self.torch.cuda.current_device()] if self.torch.cuda.is_available() else []):
+            self.torch.manual_seed(int(seed))
+            if self.torch.cuda.is_available():
+                self.torch.cuda.manual_seed_all(int(seed))
+            if not self.action_uncertainty:
+                return self.model.predict_action(examples=[sample])
+            head = self.model.action_model
+            original_predict = head.predict_action
+            measured = {}
+
+            def predict_with_uncertainty(vl_embs, state=None):
+                actions, metrics = original_predict(
+                    vl_embs,
+                    state,
+                    return_uncertainty=True,
+                    uncertainty_mode=self.uncertainty_mode,
+                    hutchinson_samples=self.hutchinson_samples,
+                )
+                measured.update({key: float(value[0].item()) for key, value in metrics.items()})
+                return actions
+
+            head.predict_action = predict_with_uncertainty
+            try:
+                output = self.model.predict_action(examples=[sample])
+            finally:
+                head.predict_action = original_predict
+            if not measured:
+                raise RuntimeError("Action uncertainty was not computed")
+            output["action_uncertainty"] = measured
+            return output
+
+    def predict_session(self, session, *, frames, instruction):
+        history = session["history"]
+        latest = None
+        for frame in frames:
+            latest = self._observation(frame, session["frame_index"])
+            self._append_history(history, latest, instruction)
+            session["frame_index"] += 1
+        if latest is None:
+            raise ValueError("predict requires at least one frame")
+        prior = self.EpisodeHistory(
+            observations=list(history.observations[:-1]),
+            instructions=list(history.instructions[:-1]),
+            poses=list(history.poses),
+            raw_actions=list(history.raw_actions),
+            long_memory_tokens=history.long_memory_tokens,
+            long_memory_tvi=history.long_memory_tvi,
+            long_memory_blocks=list(history.long_memory_blocks),
+            long_memory_frame_indices=set(history.long_memory_frame_indices),
+        )
+        sample = self.adapter.build_example(observation=latest, history=prior, instruction=instruction)
+        output = self._seeded_prediction(sample, session["seed"] + len(history.observations))
+        normalized = np.asarray(output["normalized_actions"], dtype=np.float32)
+        if normalized.ndim == 3:
+            normalized = normalized[0]
+        from tool.navvla.statistics import unnormalize_values
+
+        actions = normalized.copy()
+        actions[:, :4] = unnormalize_values(normalized[:, :4], self.action_stats_by_key[session["key"]]["action"])
+        response = {"actions": actions, "stop": False, "action_spec": "anchor_relative_body_frame_xyz_yaw"}
+        if self.action_uncertainty:
+            record = {
+                "episode_id": session["episode_id"],
+                "prediction_index": session["prediction_index"],
+                **output["action_uncertainty"],
+            }
+            response["metadata"] = {"action_uncertainty": record}
+            if self.uncertainty_log is not None:
+                self.uncertainty_log.parent.mkdir(parents=True, exist_ok=True)
+                with self.uncertainty_log.open("a", encoding="utf-8") as stream:
+                    stream.write(json.dumps(record, allow_nan=False) + "\n")
+        session["prediction_index"] += 1
+        return response
+
+
+async def serve(policy, host, port, checkpoint):
+    import websockets.asyncio.server
+    from deployment.model_server.tools import msgpack_numpy
+
+    async def handle(websocket):
+        sessions = {}
+        await websocket.send(msgpack_numpy.packb({"protocol": "simplenav.session.v1", "checkpoint": checkpoint}))
+        async for raw in websocket:
+            request = msgpack_numpy.unpackb(raw)
+            session_id = request["session_id"]
+            try:
+                if request["method"] == "reset":
+                    sessions[session_id] = policy.new_session(**request["payload"])
+                    result = None
+                elif request["method"] == "predict":
+                    result = policy.predict_session(sessions[session_id], **request["payload"])
+                elif request["method"] == "close":
+                    sessions.pop(session_id, None)
+                    result = None
+                else:
+                    raise ValueError(f"unknown method: {request['method']}")
+                response = {"ok": True, "data": result}
+            except Exception as exc:
+                import traceback
+
+                traceback.print_exc()
+                sessions.pop(session_id, None)
+                response = {"ok": False, "error": f"{type(exc).__name__}: {exc}"}
+            await websocket.send(msgpack_numpy.packb(response))
+
+    async with websockets.asyncio.server.serve(handle, host, port, compression=None, max_size=None) as server:
+        await server.serve_forever()
+
+
+if __name__ == "__main__":
+    parser = argparse.ArgumentParser()
+    parser.add_argument("--checkpoint", required=True)
+    parser.add_argument("--legacy-root", required=True)
+    parser.add_argument("--qwen-root", required=True)
+    parser.add_argument("--host", default="127.0.0.1")
+    parser.add_argument("--port", type=int, default=10093)
+    parser.add_argument("--device", default="cuda")
+    parser.add_argument("--action-uncertainty", action="store_true")
+    parser.add_argument("--uncertainty-log")
+    parser.add_argument("--uncertainty-mode", choices=("full", "diag", "hutchinson"), default="hutchinson")
+    parser.add_argument("--hutchinson-samples", type=int, default=4)
+    args = parser.parse_args()
+    policy = LegacyRXRPolicy(
+        args.checkpoint,
+        args.legacy_root,
+        args.qwen_root,
+        args.device,
+        args.action_uncertainty,
+        args.uncertainty_log,
+        args.uncertainty_mode,
+        args.hutchinson_samples,
+    )
+    asyncio.run(serve(policy, args.host, args.port, args.checkpoint))
