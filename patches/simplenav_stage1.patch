+++ b/tests/test_vlnce_ndtw.py
@@ -0,0 +1,41 @@
+from __future__ import annotations
+
+import gzip
+import json
+import tempfile
+import unittest
+from pathlib import Path
+
+import numpy as np
+
+from benchmark.common.log.metrics import ndtw_score
+from benchmark.common.runner.worker import _distinct_consecutive_positions, _vlnce_gt_locations
+from benchmark.common.types import Pose4D
+
+
+class VLNCENDTWTests(unittest.TestCase):
+    def test_dense_ground_truth_is_loaded_for_both_tasks(self):
+        with tempfile.TemporaryDirectory() as temporary:
+            root = Path(temporary)
+            for task_name, dataset, filename in (
+                ("r2r", "R2R_VLNCE_v1-3_preprocessed", "val_unseen_gt.json.gz"),
+                ("rxr", "RxR_VLNCE_v0", "val_unseen_guide_gt.json.gz"),
+            ):
+                with self.subTest(task_name=task_name):
+                    directory = root / "datasets" / dataset / "val_unseen"
+                    directory.mkdir(parents=True)
+                    expected = {"1": {"locations": [[0, 0, 0], [0.25, 0, 0], [0.5, 0, 0]]}}
+                    with gzip.open(directory / filename, "wt", encoding="utf-8") as stream:
+                        json.dump(expected, stream)
+                    loaded = _vlnce_gt_locations(str(root), task_name, "val_unseen", ("guide",))
+                    self.assertEqual(loaded, expected)
+
+    def test_stationary_waypoints_do_not_change_ndtw(self):
+        poses = [Pose4D(0, 0, 0, 0), Pose4D(0, 0, 0, 1), Pose4D(1, 0, 0, 1)]
+        positions = _distinct_consecutive_positions(poses)
+        np.testing.assert_array_equal(positions, [[0, 0, 0], [1, 0, 0]])
+        self.assertEqual(ndtw_score(positions, [[0, 0, 0], [1, 0, 0]], success_distance=3), 1.0)
